# Obtain this secret via Telegram @BotFather. NEVER commit the actual .env file.
BOT_TOKEN=123456789:REPLACE_WITH_REAL_TOKEN
# Telegram ID of the PRIVATE group (typically negative, -100...)
GROUP_CHAT_ID=-1001234567890
# Exactly two distinct user IDs, comma-separated
ALLOWED_USER_IDS=111111111,222222222
# Must be one of ALLOWED_USER_IDS
ADMIN_USER_ID=111111111
FAMILY_NAME=Сімейний бюджет
DATABASE_PATH=/app/data/budget.sqlite3
BACKUP_DIR=/app/backups
LOG_LEVEL=INFO
